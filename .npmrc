# The Prisma 8 RC packages (prisma, @prisma/orm-postgres) currently trip npm's
# peer-dependency resolver ("Cannot read properties of null (reading 'edgesOut')")
# on a strict install. legacy-peer-deps lets `npm install` complete. Revisit once
# Prisma 8 is out of release-candidate. See docs/prisma8-migration.md.
legacy-peer-deps=true
