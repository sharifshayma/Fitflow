# Fitflow environment — copy to .env and fill in. Never commit .env.

# --- Database (Prisma Postgres) ---
# Connection string for your Prisma Postgres database. Used by Prisma Client and
# by `prisma migrate`. Get it from the Prisma Console (or `prisma-cli database
# connection create <db>`).
DATABASE_URL="postgres://..."

# --- Auth (better-auth) ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="..."
# The app's base URL (used for cookies + password-reset links).
BETTER_AUTH_URL="http://localhost:3000"

# --- Password-reset email (Resend) ---
# Optional in dev: if unset, the reset link is logged to the server console.
# Required in production so migrated users can set their password on first login.
RESEND_API_KEY=""
RESEND_FROM="FitFlow <noreply@yourdomain.com>"

# --- Phase 5 data import only (one-off) ---
# Supabase Postgres connection string; read by scripts/migrate-from-supabase.ts.
# SUPABASE_DB_URL="postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres"

# --- Optional: public demo account ---
# Set to a user id to enable auto-refresh of that account's sample data when stale.
# DEMO_USER_ID=""
